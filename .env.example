# ---------------------------------------------------------------
# GENERATION provider - one of: gemini | ollama | template
# ---------------------------------------------------------------
# gemini   - free tier, works when deployed. Production default.
# ollama   - fully local/offline. Local dev only, cannot be deployed.
# template - no LLM at all; retrieval still runs. Always-works fallback.
AI_PROVIDER=gemini

# ---------------------------------------------------------------
# EMBEDDING provider - one of: gemini | local | hashing
# ---------------------------------------------------------------
# gemini  - API call, no ML deps. Required for serverless deployment.
# local   - sentence-transformers MiniLM, offline and free, but pulls
#           torch (~1GB) so it cannot run on Vercel. Local dev only.
# hashing - zero-dependency lexical fallback. No key, no network, no
#           model. NOT semantic: it matches shared terms, so it misses
#           paraphrases a real model would catch. This is also what runs
#           automatically when EMBEDDING_PROVIDER=gemini but no
#           GEMINI_API_KEY is set, so the app still boots and answers.
EMBEDDING_PROVIDER=gemini

# --- Gemini (free tier: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- Ollama (local only; https://ollama.com) -------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Local embeddings (only when EMBEDDING_PROVIDER=local) -----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- GitHub context (Phase 5) ----------------------------------
# No token and no username here on purpose. The account is read from
# content/profile.json (links.github), so the portfolio stays the single
# source of truth; and the public repo endpoint needs no auth, so there is
# no secret to store or rotate.
#
# Unauthenticated callers share 60 requests/hour per IP, which is why
# responses are cached in process rather than fetched per visitor. Trading
# a longer TTL for freshness is the only knob that usually matters.
GITHUB_API_BASE=https://api.github.com
GITHUB_REPO_LIMIT=6
GITHUB_CACHE_TTL_S=900
GITHUB_TIMEOUT_S=5.0

# --- App -------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
